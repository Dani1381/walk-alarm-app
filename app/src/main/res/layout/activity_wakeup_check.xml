<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvWakeUpTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰ WAKE-UP CHECK"
        android:textColor="@color/accent_amber"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvWakeUpSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Are you still awake? Confirm now or alarm re-rings!"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvWakeUpTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvWakeUpTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="03:00"
        android:textColor="@color/accent_rose"
        android:textSize="64sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvWakeUpSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnConfirmAwake"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnConfirmAwake"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="YES, I AM FULLY AWAKE! ☀️"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_emerald"
        app:cornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
