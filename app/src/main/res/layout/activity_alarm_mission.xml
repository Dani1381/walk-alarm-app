<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="20dp"
    android:keepScreenOn="true">

    <!-- Header / Alarm Status -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvMissionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 WAKE UP! 🚨"
            android:textColor="@color/accent_rose"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/tvMissionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complete the challenge to dismiss"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Focus / Calm Sound Banner Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalmSound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔉 Calm Sound (Focus Mode)"
        android:textColor="@color/text_main"
        android:textSize="13sp"
        android:backgroundTint="@color/surface_card"
        app:strokeColor="@color/primary_accent"
        app:strokeWidth="1dp"
        app:cornerRadius="20dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- MISSION 1: WALK CONTAINER -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardWalkMission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/surface_card"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnCalmSound"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MISSION 1: STEP DETECTOR"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <ProgressBar
                android:id="@+id/progressBarSteps"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:max="30"
                android:progress="0"
                android:progressTint="@color/accent_emerald"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvRemainingSteps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textColor="@color/accent_amber"
                    android:textSize="32sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=" steps remaining"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp"
                    android:layout_marginStart="8dp"/>

                <TextView
                    android:id="@+id/tvStepStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚶 In Progress"
                    android:textColor="@color/accent_amber"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- MISSION 2: PUZZLE & MATH CONTAINER -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPuzzleMission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/surface_card"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardWalkMission"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MISSION 2: BRAIN PUZZLE"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/tvPuzzleEquation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="37 + 48 = ?"
                android:textColor="@color/text_main"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <!-- 4 Multiple Choice Options -->
            <GridLayout
                android:id="@+id/gridPuzzleChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginTop="12dp"
                android:alignmentMode="alignMargins">

                <Button
                    android:id="@+id/btnChoice1"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="75"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:backgroundTint="#24324D"
                    app:cornerRadius="14dp"/>

                <Button
                    android:id="@+id/btnChoice2"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="85"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:backgroundTint="#24324D"
                    app:cornerRadius="14dp"/>

                <Button
                    android:id="@+id/btnChoice3"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="92"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:backgroundTint="#24324D"
                    app:cornerRadius="14dp"/>

                <Button
                    android:id="@+id/btnChoice4"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="81"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:backgroundTint="#24324D"
                    app:cornerRadius="14dp"/>
            </GridLayout>

            <TextView
                android:id="@+id/tvPuzzleStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solve 2 puzzles to pass"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Sensor info / Motivational feedback -->
    <TextView
        android:id="@+id/tvSensorInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👣 Dual sensor fusion active: walk naturally"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnDismiss"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Dismiss Button -->
    <Button
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:enabled="false"
        android:text="🔒 COMPLETE MISSIONS TO STOP"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#1E293B"
        app:cornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
