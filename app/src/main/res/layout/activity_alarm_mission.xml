<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="24dp"
    android:keepScreenOn="true">

    <TextView
        android:id="@+id/tvMissionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 WAKE UP! 🚨"
        android:textColor="@color/accent_red"
        android:textSize="34sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvMissionInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="You must walk to turn off this alarm!"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tvMissionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/progressBarSteps"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:indeterminate="false"
        android:max="30"
        android:progress="0"
        android:progressDrawable="@android:drawable/progress_horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvMissionInstruction"
        app:layout_constraintBottom_toTopOf="@id/tvSensorInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/progressBarSteps"
        app:layout_constraintBottom_toBottomOf="@id/progressBarSteps"
        app:layout_constraintStart_toStartOf="@id/progressBarSteps"
        app:layout_constraintEnd_toEndOf="@id/progressBarSteps">

        <TextView
            android:id="@+id/tvRemainingSteps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30"
            android:textColor="@color/accent_orange"
            android:textSize="54sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEPS LEFT"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvSensorInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detecting real movement..."
        android:textColor="@color/accent_green"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnDismiss"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:enabled="false"
        android:text="🔒 LOCKED — WALK TO UNLOCK"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#444444"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
