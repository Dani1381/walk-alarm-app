<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WalkAlarmApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_variant</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@color/dark_bg</item>
    </style>

    <style name="Theme.WalkAlarmApp.FullScreen" parent="Theme.WalkAlarmApp">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
